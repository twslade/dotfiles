#!/bin/sh
# User version of /usr/share/sway/scripts/help.sh.
# Adds `-l 3` (overlay layer) so the cheatsheet sits ON TOP of all windows.
# Original sits at layer 1 (bottom) and gets covered.

VISIBILITY_SIGNAL=30
QUIT_SIGNAL=2

if [ "$1" = "--toggle" ]; then
  pkill -U "$USER" -f -${VISIBILITY_SIGNAL} 'nwg-wrapper.*-s help.sh'
else
  pkill -U "$USER" -f -${QUIT_SIGNAL} 'nwg-wrapper.*-s help.sh'
  for output in $(swaymsg -t get_outputs --raw | jq -r '.[].name'); do
    # Position/alignment flags omitted on purpose: nwg-wrapper centres
    # (position) and middle-aligns when -p/-a are absent. Passing them with
    # no value is an error; "left"/"right" anchors to an edge.
    nwg-wrapper -o "$output" -l 3 -i -sv ${VISIBILITY_SIGNAL} -sq ${QUIT_SIGNAL} -s help.sh -c help.css &
  done
fi
