#!/usr/bin/env bash
# Ported from old i3 ~/.bin/scratchpad-notes.
# Old version used xfce4-terminal + X11 window_role. Sway/Wayland uses app_id.

NOTES_FILE="$HOME/Documents/notes/notes.md"
APP_ID="scratchpad-notes"

# Spawn the scratchpad terminal if it doesn't already exist.
if ! swaymsg -t get_tree | grep -q "\"app_id\":\"${APP_ID}\""; then
  foot --app-id="$APP_ID" -- vim "$NOTES_FILE" &
  # Wait briefly for the window to register so the for_window rule fires.
  sleep 0.4
fi

# Toggle visibility + recenter (matches old behavior).
swaymsg "[app_id=\"${APP_ID}\"] scratchpad show, move position center"
