# Ignore everything
*

# Bash stuff (profile just sources bashrc, since it's the only thing sourced
# when a shell is a login shell).
.*.swp

# VSCode dotfiles workspace
!dotsfiles.code-workspace

# i3 / sway
!.config
!.config/*
!.config/i3/*
!.config/sway/*
# Distro default — leave to package manager.
.config/sway/config
# nwg-displays manages this; per-monitor state churns too often to track.
.config/sway/outputs
!.config/sway/config.d/*
!.config/sway/variables.d/*
# Stock distro files in those dirs — leave to package manager.
.config/sway/config.d/*.example
.config/sway/variables.d/README.md
!.config/lf/*
!.config/mise/*
!.config/xsettingsd/*
!.config/dunst/*
!.config/picom/*
!.config/foot/*
!.config/waybar/*
!.config/mako/*
!.config/fuzzel/*
!.config/wofi/*
!.config/wireplumber
!.config/wireplumber/**
!.config/variety
!.config/variety/variety.conf
# nwg-wrapper: track only our customised cheat-sheet files; the rest of the
# dir is distro/nwg-shell stock, left to the package manager.
!.config/nwg-wrapper/help.sh
.config/Trolltech.conf
.config/mimeapps.list
.config/pavucontrol.ini
.config/user-dirs.dirs
.config/user-dirs.locale
.config/QtProject.conf
.config/zoom.conf
.config/zoomus.conf

# Systemd user-unit drop-ins (overrides for waybar, xdg-desktop-portal, etc.
# that we want to travel with the dotfiles). Only track drop-in dirs, not
# state files like timer stamps.
!.config/systemd
!.config/systemd/user
!.config/systemd/user/*.service.d
!.config/systemd/user/*.service.d/*.conf

!.profile

!.custom
!.custom/*
!.custom/secrets


# Zsh
!.zshrc
!.zsettings
!.zsettings/*
!.zprofile

#BIN
!.bin
!.bin/*

# .local/bin (XDG-style scripts; new sway-era scripts live here).
# Re-exclude tooling installed under this prefix — mise/claude live here too,
# but they're host-specific binaries/symlinks, not dotfiles.
!.local
!.local/bin
!.local/bin/*
.local/bin/mise
.local/bin/claude

#VIM
!.vimrc
!.vim
!.vim/*
.vim/.netrwhist
!.vim/colors
!.vim/colors/*
!.vim/bundle
!.vim/bundle/*

# Cheat
!.cheat
!.cheat/*

# Git aliases, identification info
!.gitconfig

# The gitignore of this repository itself (!)
!.gitignore

# My global Git excludes file (acts as a global .gitignore)
!.gitexcludes

# Claude Code global user instructions
!.claude
!.claude/CLAUDE.md
